"""
Calibration module for the web interface.
"""

import logging
import threading
import time
import traceback
from copy import deepcopy
from dataclasses import dataclass
from typing import Any, Literal

from lerobot.motors import MotorCalibration
from lerobot.utils.utils import init_logging

from .utils.devices import safe_disconnect_device
from .arduino_driver import ArduinoRobotDriver
from .arduino_robot import ArduinoLeader, ArduinoLeaderConfig, CONTINUOUS_MOTORS

logger = logging.getLogger(__name__)

_MIN_VALID_POSITION = -1
_MAX_VALID_POSITION = 5000
_MAX_POSITION_JUMP = 2000
_MIN_CALIBRATION_RANGE = 100


def _is_valid_position(pos: float) -> bool:
    return _MIN_VALID_POSITION < pos < _MAX_VALID_POSITION


class CalibrationDiscontinuityError(Exception):
    pass


@dataclass
class CalibrationStatus:
    calibration_active: bool = False
    status: str = "idle"
    device_type: str | None = None
    error: str | None = None
    message: str = ""
    step: int = 0
    total_steps: int = 1
    current_positions: dict[str, float] = None
    recorded_ranges: dict[str, dict[str, float]] = None


@dataclass
class CalibrationRequest:
    device_type: Literal["robot", "teleop"]
    port: str
    config_file: str
    robot_name: str | None = None


class CalibrationManager:
    def __init__(self):
        self.status = CalibrationStatus()
        self.device: ArduinoRobotDriver | None = None
        self.gamepad_leader: ArduinoLeader | None = None
        self._gamepad_stop = threading.Event()
        self._gamepad_thread: threading.Thread | None = None
        self.calibration_thread: threading.Thread | None = None
        self.stop_calibration = False
        self._status_lock = threading.Lock()
        self._step_complete = threading.Event()
        self._recording_active = False
        self._start_positions = {}
        self._mins = {}
        self._maxes = {}
        self._homing_offsets = {}
        self._current_request: CalibrationRequest | None = None
        init_logging()

    def get_status(self) -> CalibrationStatus:
        with self._status_lock:
            return deepcopy(self.status)

    def _update_status(self, **kwargs):
        with self._status_lock:
            for key, value in kwargs.items():
                if hasattr(self.status, key):
                    setattr(self.status, key, value)

    def _cache_recorded_ranges(self, positions: dict[str, float]) -> None:
        updates = {
            motor: {
                "min": self._mins[motor],
                "max": self._maxes[motor],
                "current": pos,
            }
            for motor, pos in positions.items()
            if motor in self._mins
        }
        with self._status_lock:
            if self.status.status != "recording":
                return
            recorded_ranges = dict(self.status.recorded_ranges or {})
            recorded_ranges.update(updates)
            self.status.recorded_ranges = recorded_ranges

    def start_calibration(self, request: CalibrationRequest) -> dict[str, Any]:
        try:
            if self.status.calibration_active:
                return {"success": False, "message": "Calibration already active"}

            self._start_positions = {}
            self._mins = {}
            self._maxes = {}
            self._homing_offsets = {}

            self._update_status(
                calibration_active=True,
                status="connecting",
                device_type=request.device_type,
                error=None,
                message=f"Starting calibration for {request.device_type}",
                step=0,
                current_positions=None,
                recorded_ranges=None,
            )
            self._current_request = request

            self.calibration_thread = threading.Thread(
                target=self._calibration_worker, args=(request,), daemon=True
            )
            self.stop_calibration = False
            self._step_complete.clear()
            self.calibration_thread.start()

            return {"success": True, "message": "Calibration started"}
        except Exception as e:
            logger.error(f"Error starting calibration: {e}")
            self._update_status(calibration_active=False, status="error", error=str(e), message="Failed to start calibration")
            return {"success": False, "message": str(e)}

    def complete_step(self) -> dict[str, Any]:
        try:
            if not self.status.calibration_active:
                return {"success": False, "message": "No calibration active"}
            if self.status.status == "recording":
                self._recording_active = False
                self._step_complete.set()
                return {"success": True, "message": "Range recording completed"}
            else:
                return {"success": False, "message": f"Cannot complete step in status: {self.status.status}"}
        except Exception as e:
            logger.error(f"Error completing step: {e}")
            return {"success": False, "message": str(e)}

    def stop_calibration_process(self) -> dict[str, Any]:
        try:
            if not self.status.calibration_active:
                return {"success": False, "message": "No calibration active"}
            logger.info("Stopping calibration process...")
            self.stop_calibration = True
            self._recording_active = False
            self._step_complete.set()
            self._update_status(status="stopping", message="Stopping calibration...")
            if self.calibration_thread and self.calibration_thread.is_alive():
                self.calibration_thread.join(timeout=5.0)
            if self.calibration_thread and self.calibration_thread.is_alive():
                logger.warning("Calibration thread did not finish within timeout, forcing cleanup")
            self._cleanup_and_finish("Calibration stopped", status="idle")
            logger.info("Calibration stop completed")
            return {"success": True, "message": "Calibration stopped"}
        except Exception as e:
            logger.error(f"Error stopping calibration: {e}")
            self._cleanup_and_finish("Calibration stopped with error", status="error")
            return {"success": False, "message": str(e)}

    def _calibration_worker(self, request: CalibrationRequest):
        try:
            logger.info(f"Starting calibration worker for {request.device_type}")

            # Arduino 6DOF driver (v8 protocol)
            self.device = ArduinoRobotDriver(port=request.port)
            self._update_status(status="connecting", message="Connecting to Arduino...")
            logger.info("Connecting Arduino...")
            self.device.connect()
            # Share the calibration driver's serial connection; never open COM9 twice.
            self.gamepad_leader = ArduinoLeader(
                ArduinoLeaderConfig(port=request.port)
            )
            self.gamepad_leader.share_driver(self.device)

            if self.stop_calibration:
                logger.info("Calibration stopped after device connection")
                self._cleanup_and_finish("Calibration cancelled")
                return

            # Step 1: Homing
            self._step_homing()

            if self.stop_calibration:
                logger.info("Calibration stopped after homing step")
                self._cleanup_and_finish("Calibration cancelled")
                return

            # Step 2: Range Recording
            self._step_range_recording()

            if self.stop_calibration:
                logger.info("Calibration stopped after recording step")
                self._cleanup_and_finish("Calibration cancelled")
                return

            # Complete calibration
            self._complete_calibration()

            logger.info("Calibration completed successfully")
            self._cleanup_and_finish("Calibration completed successfully", status="completed")

        except CalibrationDiscontinuityError as e:
            logger.error(f"Calibration discontinuity: {e}")
            self._update_status(error=str(e))
            self._cleanup_and_finish(str(e), status="error")
        except Exception as e:
            logger.error(f"Calibration error: {e}")
            logger.error(traceback.format_exc())
            self._cleanup_and_finish(f"Calibration failed: {e}", status="error")
        finally:
            logger.info("Calibration worker thread finishing")
            if self.status.calibration_active:
                logger.warning("Worker thread ending but calibration still marked as active - forcing cleanup")
                self._cleanup_and_finish("Calibration stopped", status="idle")

    def _step_homing(self):
        """Auto-capture homing offsets from Arduino current position."""
        logger.info("Setting homing offsets from Arduino current position")
        self.device.home()
        state = self.device.refresh_state(timeout=2.0)
        logger.info(f"Arduino state after HOME: {state}")
        self._homing_offsets = {name: 0 for name in state or ["base","shoulder","elbow","wrist","rotate","gripper"]}

    def _step_range_recording(self):
        """Record range of motion as the user moves all joints."""
        logger.info("Starting range recording step")

        self._start_positions = {}
        for attempt in range(5):
            try:
                positions = self.device.refresh_state(timeout=2.0)
                valid_positions = {}
                for motor, pos in positions.items():
                    if _is_valid_position(pos):
                        valid_positions[motor] = pos
                if len(valid_positions) == len(positions):
                    self._start_positions = valid_positions
                    break
                else:
                    logger.warning(f"Attempt {attempt + 1}: Got invalid initial positions, retrying...")
                    time.sleep(0.1)
            except Exception as e:
                logger.warning(f"Attempt {attempt + 1}: Failed to read initial positions: {e}")
                time.sleep(0.1)

        if not self._start_positions:
            raise RuntimeError("Could not get valid initial positions after multiple attempts")

        logger.info(f"Starting positions for range recording: {self._start_positions}")

        self._mins = self._start_positions.copy()
        self._maxes = self._start_positions.copy()
        logger.info(f"Initialized mins: {self._mins}")
        logger.info(f"Initialized maxes: {self._maxes}")

        self._update_status(
            status="recording",
            step=1,
            message="Move ALL joints through their FULL ranges of motion - from minimum to maximum positions.",
            recorded_ranges={
                motor: {"min": pos, "max": pos, "current": pos}
                for motor, pos in self._start_positions.items()
            },
        )

        self._recording_active = True
        prev_positions: dict[str, int] = dict(self._start_positions)
        self._gamepad_stop.clear()
        self._gamepad_thread = threading.Thread(
            target=self._calibration_gamepad_loop,
            name="calibration-gamepad-control",
            daemon=True,
        )
        self._gamepad_thread.start()

        while not self._step_complete.is_set() and not self.stop_calibration:
            try:
                positions = None
                for attempt in range(3):
                    try:
                        positions = self.device.refresh_state(timeout=1.0)
                        break
                    except Exception as read_error:
                        if attempt < 2:
                            time.sleep(0.01)
                            continue
                        else:
                            raise read_error

                if positions:
                    valid_positions = {}
                    for motor, pos in positions.items():
                        if _is_valid_position(pos):
                            valid_positions[motor] = pos
                        else:
                            logger.debug(f"Filtered invalid position for {motor}: {pos}")

                    if valid_positions:
                        for motor, pos in valid_positions.items():
                            if motor in prev_positions:
                                if abs(pos - prev_positions[motor]) > _MAX_POSITION_JUMP:
                                    raise CalibrationDiscontinuityError(
                                        "Motor discontinuity detected. Make sure to start "
                                        "the calibration with the robot in a middle position."
                                    )
                                prev_positions[motor] = pos
                            if motor in self._mins:
                                self._mins[motor] = min(self._mins[motor], pos)
                                self._maxes[motor] = max(self._maxes[motor], pos)
                        self._cache_recorded_ranges(valid_positions)

                time.sleep(0.05)
            except CalibrationDiscontinuityError:
                raise
            except Exception as e:
                logger.warning(f"Error reading positions during recording: {e}")
                time.sleep(0.2)

        self._gamepad_stop.set()
        if self._gamepad_thread and self._gamepad_thread.is_alive():
            self._gamepad_thread.join(timeout=1.0)
        self._gamepad_thread = None

        if self.stop_calibration:
            logger.info("Range recording step cancelled due to stop request")
            return

        logger.info("Final recorded ranges:")
        for motor in self._mins:
            logger.info(f"  {motor}: min={self._mins[motor]}, max={self._maxes[motor]}, range={self._maxes[motor] - self._mins[motor]}")

        same_min_max = [motor for motor in self._mins if self._mins[motor] == self._maxes[motor]]
        if same_min_max:
            # Wervo SR 150 MG servos have no encoder feedback, so a joint that was
            # never moved has no measurable range. That is not a fatal error for
            # this arm - the Arduino tracks the commanded position itself.
            logger.warning(
                f"No measured range for {same_min_max} (joint not moved during recording). "
                f"Continuing - Arduino tracks commanded positions internally."
            )
            # Give unmoved joints a nominal range so downstream code has valid data.
            for motor in same_min_max:
                self._maxes[motor] = self._mins[motor] + 1

        insufficient_range = []
        for motor in self._mins:
            range_diff = self._maxes[motor] - self._mins[motor]
            if range_diff < _MIN_CALIBRATION_RANGE:
                insufficient_range.append(f"{motor}: {range_diff}")

        if insufficient_range:
            logger.warning(f"Some motors may not have been moved through sufficient range: {insufficient_range}")
            logger.warning("Consider moving all joints through their full range of motion during calibration")

        self._step_complete.clear()
        logger.info("Range recording step completed")

    def _calibration_gamepad_loop(self):
        """Read gamepad, log raw inputs and commands, and move slowly."""
        leader = self.gamepad_leader
        driver = self.device

        if leader is None or driver is None:
            logger.error("Calibration gamepad/Arduino is not initialized")
            return

        import pygame

        axis_names = {
            0: "LEFT_X / BASE",
            1: "LEFT_Y / SHOULDER",
            2: "RIGHT_X / ROTATE",
            3: "RIGHT_Y / WRIST",
            4: "LEFT_TRIGGER / ELBOW_DOWN",
            5: "RIGHT_TRIGGER / ELBOW_UP",
        }
        button_names = {
            0: "A / GRIPPER_CLOSE",
            1: "B / GRIPPER_OPEN",
            2: "X",
            3: "Y",
            4: "L1 / ELBOW_DOWN",
            5: "R1 / ELBOW_UP",
        }

        logger.info("DETAILED GAMEPAD DEBUG ACTIVE")
        logger.info("Move only one control at a time; watch the terminal.")

        last_debug = 0.0

        while not self._gamepad_stop.is_set() and not self.stop_calibration:
            try:
                action = leader.get_action()
                gp = leader._gamepad
                axes = []
                buttons = []
                pressed_names = []

                if gp is not None and leader._gamepad_backend == "pygame":
                    # get_action() already pumps the pygame event queue.
                    axes = [
                        round(float(gp.get_axis(i)), 3)
                        for i in range(gp.get_numaxes())
                    ]
                    buttons = [
                        int(gp.get_button(i))
                        for i in range(gp.get_numbuttons())
                    ]
                    pressed_names = [
                        button_names.get(i, f"BUTTON_{i}")
                        for i, value in enumerate(buttons)
                        if value
                    ]

                deltas = []
                for motor in CONTINUOUS_MOTORS:
                    value = float(action.get(f"{motor}.pos", 0.0))
                    if abs(value) < 0.15:
                        deltas.append(0)
                    else:
                        deltas.append(1 if value > 0 else -1)

                wire = getattr(driver, "gripper_wire", 0)
                driver.send_delta(deltas, wire)

                now = time.monotonic()
                if now - last_debug >= 1.0:
                    active_axes = {
                        axis_names.get(i, f"AXIS_{i}"): value
                        for i, value in enumerate(axes)
                        if abs(value) > 0.15
                    }
                    print(
                        "\\n[CALIBRATION GAMEPAD DEBUG]"
                        f"\\n  backend       = {leader._gamepad_backend}"
                        f"\\n  device        = {gp.get_name() if gp else None}"
                        f"\\n  raw_axes      = {axes}"
                        f"\\n  active_axes   = {active_axes}"
                        f"\\n  raw_buttons   = {buttons}"
                        f"\\n  pressed       = {pressed_names}"
                        f"\\n  mapped_action = {action}"
                        f"\\n  sent_deltas   = {deltas} "
                        "(base, shoulder, elbow, wrist, rotate)"
                        f"\\n  gripper_wire  = {wire}"
                        "\\n----------------------------------------",
                        flush=True,
                    )
                    last_debug = now

            except Exception:
                logger.exception("Calibration gamepad control failed")
                time.sleep(0.2)

            time.sleep(0.12)

        logger.info("Calibration gamepad control stopped")
\n    def _complete_calibration(self):
        """Complete the calibration and save results to disk."""
        import json
        import os

        logger.info("Completing calibration...")
        for motor in self._mins:
            logger.info(
                f"  {motor}: min={self._mins[motor]}, max={self._maxes[motor]}, "
                f"range={self._maxes[motor] - self._mins[motor]}"
            )

        # Build a lerobot-style calibration dict so record/teleoperate can load it.
        motor_index = {"base": 1, "shoulder": 2, "elbow": 3, "wrist": 4, "rotate": 5, "gripper": 6}
        calibration = {}
        for motor, idx in motor_index.items():
            if motor not in self._mins:
                continue
            calibration[motor] = {
                "id": idx,
                "drive_mode": 0,
                "homing_offset": 0,
                "range_min": int(self._mins[motor]),
                "range_max": int(self._maxes[motor]),
            }

        request = self._current_request
        config_file = request.config_file if request else "custom6dof"
        config_name = os.path.splitext(os.path.basename(config_file))[0]

        from .utils.config import FOLLOWER_CONFIG_PATH, LEADER_CONFIG_PATH

        device_type = request.device_type if request else "teleop"
        if device_type == "robot":
            base_dir, sub = FOLLOWER_CONFIG_PATH, "robots"
        else:
            base_dir, sub = LEADER_CONFIG_PATH, "teleoperators"

        os.makedirs(base_dir, exist_ok=True)
        target = os.path.join(base_dir, f"{config_name}.json")
        with open(target, "w") as f:
            json.dump(calibration, f, indent=2)
        logger.info(f"Calibration saved to {target}")

        # Write the config name back to the robot record so the UI stops asking
        # to configure the arm.
        if request is not None and request.robot_name:
            from .utils.config import save_robot_record

            if device_type == "teleop":
                patch = {"leader_port": request.port, "leader_config": f"{config_name}.json"}
            else:
                patch = {"follower_port": request.port, "follower_config": f"{config_name}.json"}
            try:
                save_robot_record(request.robot_name, patch, allow_create=False)
                logger.info(f"Robot record updated: {patch}")
            except Exception as e:
                logger.warning(f"Robot-record write-back failed for {request.robot_name}: {e}")

        logger.info("Arduino calibration completed successfully")
        logger.info("Arduino trims preserved in EEPROM (v8 protocol)")

    def _cleanup_and_finish(self, message: str, status: str = "completed"):
        self._cleanup_device()
        self._recording_active = False
        self._update_status(calibration_active=False, status=status, message=message)

    def _cleanup_device(self):
        self._gamepad_stop.set()
        if self._gamepad_thread and self._gamepad_thread.is_alive():
            self._gamepad_thread.join(timeout=1.0)
        self._gamepad_thread = None
        if self.gamepad_leader:
            try:
                self.gamepad_leader.disconnect()
            except Exception:
                logger.exception("Error disconnecting calibration gamepad")
            self.gamepad_leader = None
        if self.device:
            logger.info("Disconnecting Arduino...")
            if hasattr(self.device, 'disconnect'):
                self.device.disconnect()
            self.device = None


calibration_manager = CalibrationManager()
